# Copy to .env and adjust. The app should connect as the non-owner attest_app
# role (see migrations/0005_rls.sql) so row-level security applies.
DATABASE_URL=postgres://localhost/attestation

# Dev only. In production the ledger signing key lives in KMS/HSM and never
# appears here -- the Signer interface stays the same.
# LEDGER_SIGNING_KEY=
